<?xml version="1.0" encoding="UTF-8"?>
<phpunit colors="true" convertWarningsToExceptions="false" defaultTestSuite="offline">
    <testsuites>
        <!-- Run the suites in separate processes: the offline suite blocks the built-in cURL transport,
             which a real cURL call made earlier in the same process would bypass. -->
        <testsuite name="offline">
            <directory>tests/Offline</directory>
        </testsuite>
        <testsuite name="realApi">
            <directory>tests/RealApi</directory>
        </testsuite>
    </testsuites>

    <coverage>
        <include>
            <directory suffix=".php">src/</directory>
        </include>
        <report>
            <cobertura outputFile="reports/cobertura.xml" />
        </report>
    </coverage>
    <logging>
        <junit outputFile="reports/junit.xml" />
    </logging>

    <php>
        <ini name="memory_limit" value="256M" />
    </php>
</phpunit>
